# Supabase Projekt-Einstellungen (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nur fuer serverseitige Admin-Aufgaben (Admin-Dashboard-Auswertungen,
# Konto-Loeschung). NIEMALS im Client verwenden und NIEMALS mit
# NEXT_PUBLIC_ prefixen. Zu finden unter Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Basis-URL der App, wird fuer absolute Links (z. B. in E-Mails), robots.txt
# und sitemap.xml genutzt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bootstrap-Fallback fuer /admin-Zugriff (Komma-getrennt), bevor ein Nutzer
# ueber public.users.is_admin als Admin markiert wurde. Siehe
# docs/SECURITY.md, Abschnitt "Admin-Autorisierung".
ADMIN_EMAILS=du@deine-domain.de

# Stripe (Abrechnung, siehe docs/BILLING.md). Optional: ohne diese Werte
# zeigt /dashboard/billing einen "nicht eingerichtet"-Hinweis statt eines
# funktionierenden Checkouts – die App startet trotzdem normal.
# sk_test_... fuer Testmodus, sk_live_... fuer echte Zahlungen.
STRIPE_SECRET_KEY=sk_test_...
# Signing-Secret des Webhook-Endpunkts (Stripe Dashboard -> Webhooks ->
# Endpunkt fuer https://DEINE-DOMAIN/api/webhooks/stripe anlegen).
STRIPE_WEBHOOK_SECRET=whsec_...
# Price-IDs der drei bezahlten Plaene (Stripe Dashboard -> Product catalog).
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
