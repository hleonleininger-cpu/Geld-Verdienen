# Supabase Projekt-Einstellungen (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nur fuer serverseitige Admin-Aufgaben (Seed-Skripte). NIEMALS im Client verwenden
# und NIEMALS mit NEXT_PUBLIC_ prefixen. Zu finden unter Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Basis-URL der App, wird fuer absolute Links (z. B. in E-Mails) genutzt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-Mail-Adresse(n), die Zugriff auf /admin erhalten (Komma-getrennt)
ADMIN_EMAILS=du@deine-domain.de
